# Every NEXT_PUBLIC_* value is baked into public JavaScript. Never put a secret here (SEC-SEC-01).
# Set real values in Cloudflare Pages → Settings → Environment variables, separately for Production and Preview.

# Canonical origin, no trailing slash. Production: https://calculatorporch.com
NEXT_PUBLIC_SITE_URL=https://calculatorporch.com

# "true" ONLY in the Cloudflare Production environment. Anything else renders <meta name="robots" content="noindex">
# and a Disallow-all robots.txt, so previews never get indexed.
NEXT_PUBLIC_INDEXABLE=false

# Which content batch is generated (docs/02).
NEXT_PUBLIC_CURRENT_BATCH=1

# Ads stay off until the playbook §0.2 gate. Set to "true" ONLY in Cloudflare Production, and only after the gate (SEC-ADS-01/02).
NEXT_PUBLIC_ADS_ENABLED=false

# GA4 measurement ID. Leave empty until the consent banner is live (SEC-PRIV-03, security/02 §5 phase B).
NEXT_PUBLIC_GA_ID=
