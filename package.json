{
  "name": "calculatorporch",
  "version": "0.1.0",
  "private": true,
  "description": "Calculator Porch: free, sourced calculators for home and hobby projects (calculatorporch.com).",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "node scripts/gen-public-files.mjs && next dev",
    "build": "node scripts/gen-public-files.mjs && next build && node scripts/flatten-segments.mjs && node scripts/check-out.mjs",
    "serve": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "vitest run tests/content.test.ts",
    "check:release": "vitest run tests/content.test.ts --mode release",
    "check:repo": "node scripts/check-repo.mjs",
    "audit": "node scripts/audit.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check:repo && npm run audit && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-regexp": "2.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
